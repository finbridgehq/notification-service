# ==========================================================
# Vankoo Notification Service: variables de entorno
# Copia este archivo a .env para desarrollo local (pnpm start:dev).
# En Docker las pone vankoo-infra/docker-compose.yaml y en Azure el Container App.
# ==========================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Nombre con el que otros servicios (y Eureka) llegan a esta instancia
INSTANCE_HOSTNAME=localhost
# Web de la Mype: los emails enlazan aquí
WEB_APP_URL=http://localhost:5173

# --- Discovery Server (Eureka) ---
# true en local/Docker; false en Azure (allí no hay Eureka)
EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761

# --- Kafka ---
KAFKA_ENABLED=true
# Desde tu PC: localhost:9092. Dentro de Docker: kafka-broker:9094
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-delivery-v1
# false: un grupo nuevo empieza por los mensajes nuevos (no reenvía el histórico)
KAFKA_FROM_BEGINNING=false
KAFKA_DLQ_TOPIC=notification.delivery.dlq
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BASE_DELAY_MS=500
# Desplegado (p. ej. Azure Event Hubs con endpoint Kafka): SSL + SASL
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=$ConnectionString
# KAFKA_SASL_PASSWORD=

# --- Push (Firebase Cloud Messaging) ---
# logging: escribe el push en el log (FCM no tiene emulador). firebase: envío real.
PUSH_PROVIDER=logging
# Secreto para derivar el topic de cada usuario (mínimo 16 caracteres). Obligatorio en producción.
PUSH_TOPIC_SECRET=vankoo-local-push-topic-secret
# Cuenta de servicio de Firebase (o deja las tres vacías y usa GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Con los saltos de línea escritos como \n
FIREBASE_PRIVATE_KEY=

# --- Email (SMTP) ---
# logging: escribe el email en el log. smtp: lo envía (en local, a Mailpit).
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Vankoo <no-reply@vankoo.local>

# --- ACL hacia Profile Service ---
# Vacío: se busca en Eureka por PROFILE_SERVICE_APP_ID. Con valor, se usa esta URL (Azure).
PROFILE_SERVICE_URL=
PROFILE_SERVICE_APP_ID=profile-service
PROFILE_SERVICE_TIMEOUT_MS=3000

# --- Idempotencia (en memoria) ---
IDEMPOTENCY_CACHE_SIZE=10000
IDEMPOTENCY_TTL_MS=86400000
